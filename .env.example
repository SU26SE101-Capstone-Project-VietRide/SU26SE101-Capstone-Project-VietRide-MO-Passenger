# API
EXPO_PUBLIC_API_BASE_URL=https://api.vietride.online/v1
EXPO_PUBLIC_WS_URL=wss://ws.vietride.online

# Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_KEY_HERE

# Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Demo mode — controls fixture data for screens without a real BE controller
# Rules:
#   development: defaults ON only in __DEV__; set "true"/"false" explicitly otherwise.
#   staging    : defaults OFF. Set "true" to enable fixture data.
#   production : ALWAYS off — this var is ignored in production builds.
# Local features (PopularRoutes, RecentSearches) are NOT gated by this flag.
# EXPO_PUBLIC_DEMO_MODE=true
