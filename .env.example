# API
EXPO_PUBLIC_API_BASE_URL=https://api.vietride.online/v1
EXPO_PUBLIC_WS_URL=wss://ws.vietride.online
# Tracking currently connects through the API origin at /tracking/socket.io.
# Keep this reserved variable aligned with infrastructure before using it.

# Goong Places REST API (Shuttle address search)
# EXPO_PUBLIC_* values are observable in the Mobile bundle. Use a dedicated,
# least-privilege Goong API key with quotas/monitoring; never call it a secret or
# print key-bearing request URLs. Production builds require both values below.
EXPO_PUBLIC_GOONG_PLACES_ENABLED=true
EXPO_PUBLIC_GOONG_API_KEY=YOUR_GOONG_API_KEY

# Mapbox (Ticket/Parcel/Shuttle live tracking maps)
# This pk.* token is a public Mobile runtime identifier. Create a dedicated
# least-privilege token for VietRide Passenger; Mapbox URL restrictions do not
# support native mobile SDK requests.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.YOUR_MOBILE_PUBLIC_TOKEN
# Native SDK artifact download token: secret sk.* with DOWNLOADS:READ only.
# Keep it in the local shell/CI/EAS secret store, never EXPO_PUBLIC_* and never
# commit a real value. Local builds may alternatively use the host-level
# ~/.gradle/gradle.properties and ~/.netrc setup documented by Mapbox.
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.YOUR_DOWNLOADS_READ_TOKEN

# Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Google Sign-In. These are OAuth client identifiers, not client secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.YOUR_IOS_CLIENT_ID

# Firebase Web SDK config. Storage writes remain authorized by a short-lived
# custom token from the BE; do not place any Firebase admin credential here.
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_WEB_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID

# Native Firebase Messaging (FCM). These are local/EAS file paths, not public
# environment values. Download the platform files from Firebase Console.
# GOOGLE_SERVICES_ANDROID_FILE=./google-services.json
# GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist

# Demo mode — controls fixture data for screens without a real BE controller
# Rules:
#   development: defaults ON only in __DEV__; set "true"/"false" explicitly otherwise.
#   staging    : defaults OFF. Set "true" to enable fixture data.
#   production : ALWAYS off — this var is ignored in production builds.
# Local features (PopularRoutes, RecentSearches) are NOT gated by this flag.
# EXPO_PUBLIC_DEMO_MODE=true
